# Copie para .env e preencha
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OLLAMA não precisa de chave (local em http://localhost:11434)

# --- Login "Entrar com Google" em um clique (opcional) ---
# Se preenchidos, os conectores Google (Calendar/Drive/Gmail) usam estas
# credenciais de app e você só clica "Entrar com Google" — sem colar nada.
# Crie um OAuth Client (tipo Aplicativo Web) no Google Cloud e registre a URI
# de redirecionamento: http://localhost:7777/api/oauth/callback
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- Login "Entrar com GitHub" em um clique (opcional) ---
# Crie um OAuth App em github.com/settings/developers e registre a mesma URI:
# http://localhost:7777/api/oauth/callback
# GITHUB_CLIENT_ID=Iv1.xxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxx

# --- Login "Entrar com Slack" em um clique (opcional) ---
# Crie um app em api.slack.com/apps, adicione os Bot Token Scopes
# (chat:write, channels:read, groups:read) e registre a mesma Redirect URL:
# http://localhost:7777/api/oauth/callback
# SLACK_CLIENT_ID=xxxxxxxx.xxxxxxxx
# SLACK_CLIENT_SECRET=xxxxxxxx
